<div
    class="offcanvas offcanvas-end"
    tabindex="-1"
    id="expertOffcanvas"
    aria-labelledby="expertOffcanvasLabel">

    <div class="offcanvas-header">
        <h5
            class="offcanvas-title"
            id="expertOffcanvasLabel">
            Expert Suggestion
        </h5>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close">
        </button>
    </div>

    <div class="offcanvas-body">

        <h4>Ask an Expert</h4>

        <textarea
            class="form-control"
            rows="5"
            placeholder="अपना सवाल यहाँ लिखें...">
        </textarea>

        <button class="btn btn-success mt-3">
            Ask Question
        </button>

    </div>
</div>