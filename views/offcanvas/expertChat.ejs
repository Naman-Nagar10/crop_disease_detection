<div
    class="offcanvas offcanvas-end"
    tabindex="-1"
    id="expertOffcanvas"
    aria-labelledby="expertOffcanvasLabel" 
    style="width: 500px; ">

    <div class="offcanvas-header">
        <div>
            <h2
                class="offcanvas-title"
                id="expertOffcanvasLabel">
                 किसान <span>Community</span>
            </h2>

            <p>किसान se किसानों tak Gyaan</p>
        </div>
    
        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close">
        </button>
    </div>
    <hr>

    <div class="offcanvas-body">

        <% if (!user) { %>
            <p>सवाल पूछने के लिए पहले login करें।</p>
            <a class="btn btn-success" href="/login">Login करें</a>
        <% } else { %>
            <h4>+ Ask Question</h4>
            <form method="post" action="/community/questions">
                <textarea class="form-control" name="question" rows="5" required maxlength="2000" placeholder="अपना खेती से जुड़ा सवाल यहाँ लिखें..."></textarea>
                <input class="form-control mt-2" name="category" maxlength="100" placeholder="फसल / Category (optional)">
                <button class="btn btn-success mt-3" type="submit">Question submit करें</button>
            </form>
            <a class="btn btn-outline-success mt-3" href="/community">सभी Questions और Answers देखें</a>
        <% } %>

    </div>
</div>
