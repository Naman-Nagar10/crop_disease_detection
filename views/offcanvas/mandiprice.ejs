<div
    class="offcanvas offcanvas-end"
    tabindex="-1"
    id="mandiOffcanvas"
    aria-labelledby="mandiOffcanvasLabel"
    style="width: 500px;">

    <div class="offcanvas-header">
        <div>
            <h2 class="offcanvas-title" id="mandiOffcanvasLabel">
                Mandi Prices
            </h2>

            <p>नज़दीकी मंडियों के भाव देखकर सही समय पर सही फैसला लें।</p>
        </div>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close">
        </button>
    </div>
    <hr>

    <div class="offcanvas-body">

        <h3><span>Check Mandi Price</span></h3>
        <p>अपनी फसल और लोकेशन (क्षेत्र) Select करें।</p>

        <!-- --------STATE------------ -->
        <div class="mb-3">
            <label for="state" class="form-lable">State</label>

            <select id="state" class="form-select" aria-label="State">
                <option value="">State चुनें</option>
                <option value="Uttar Pradesh">Uttar Pradesh</option>
                <option value="Punjab">Punjab</option>
                <option value="Haryana">Haryana</option>
                <option value="Maharashtra">Maharashtra</option>
                <option value="Madhya Pradesh">Madhya Pradesh</option>
            </select>
        </div>


        <!-- ----------DISTRICT--------------- -->
        <div class="mb-3">
            <label for="district" class="form-lable">District</label>

            <select id="district" class="form-select" disabled>
                <option value="">Select District</option>
            </select>
        </div>


        <!-- -----------CROP------------------- -->
        <div class="mb-3">
            <label for="crop" class="form-lable">Crop</label>

            <select id="crop" class="form-select" disabled>
                <option value="">पहले District चुनें</option>
            </select>
        </div>


        <!-- ----------------BUTTON-------------- -->
        <button id="mandi-price" class="btn btn-success w-100" disabled>
            भाव देखें 
        </button>

        <p id="mandiStatus" class="status-message" role="status"></p>


        <div id="priceResult" class="price-result">
            <h5>Mandi Price <small id="priceDate"></small></h5>

            <p>Market: <span id="marketName">-</span></p>
            <p>Crop: <span id="cropName">-</span></p>

            <div class="price-box">
                <div>
                    <small>Min Price</small>
                    <strong id="minPrice">₹ -</strong>
                </div>

                <div>
                    <small>Max Price</small>
                    <strong id="maxPrice">₹ -</strong>
                </div>

                <div>
                    <small>Modal Price</small>
                    <strong id="modalPrice">₹ -</strong>
                </div>
            </div>
        </div>

    </div>
</div>
