<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Krishak - Home</title>
</head>
<body>
    <header>
        <%- include('partials/navbar') %>
    </header>

    <!-- ----LAYOUT---- -->

    <div class="layout">
        <%- include('partials/sidebar') %>

        <main class="main-content">     <!--ye main content ka page hai  -->

            <div class="dashboard">                  
                <h1>Namaskar <span>किसान भाइयों!</span></h1>
                <p class="welcome">अपने खेत की सेहत पर नज़र रखें, सही सलाह पाएं और बेहतर फैसला लें।</p>

                <section class="hero-poster">
                    <div></div>
                </section>

                <hr>

                <div class="tool">
                    <p class="small-heading">YOUR DAILY TOOLS</p>
                    <h2 class="medium-heading">जहाँ से खेती आगे बढ़े </h2>
                </div>

                <section class="tool-container">
                    <div class="card" id="scan-card">
                        <h3>Detect Disease</h3>
                        <p>Upload a crop photo and instantly, <br> know the exact disease and treatment.</p>
                        <a href="/upload" class="btn">Upload photo</a>
                    </div>

                    <div class="card same-size" id="chat-card">
                        <h3>Chat with AI</h3>
                        <p>आप फसलों, कीटों (pests) या मौसम <br>से जुड़ा कोई भी सवाल पूछ सकते हैं!</p>
                        <a href="/chat" class="btn">Upload photo</a>
                    </div>

                    <div class="card same-size" id="scheme-card">
                        <h3>Government <br> Schemes</h3>
                        <p>View all government schemes <br> according to your state</p>
                        <a href="/schemes" class="btn">Upload photo</a>
                    </div>
                    
                </section>
                
                <hr>

                <div class="tool another-toll">
                    <p class="small-heading">ANOTHER HELPFUL TOOLS</p>
                </div>

                <section class="tool-container another-tool">
                    <div class="card" id="mandi">
                        <h3>mandi price</h3>
                        <p>live price </p>
                        <a href="#" class="btn">Know price</a>
                    </div>

                    <div class="card same-size" id="Expert">
                        <h3>Expert Suggestion</h3>
                        <p>Take expert advice</p>
                        <a href="#" class="btn">Ask Question</a>
                    </div>
                    
                </section>
 
            </div>
        </main>
        <%- include('partials/footer') %>
    </div>

    
    
    <%- include('partials/script') %>
</body>
</html>