<!DOCTYPE html>
<html lang="hi">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/auth.css">
    <title>Reset Password · Krishi Rakshak</title>
</head>
<body class="auth-page">
<main class="auth-wrapper">
    <section class="auth-card">
        <a class="auth-brand" href="/">
            <span class="brand-icon"><i class="fa-solid fa-seedling"></i></span>
            <span>Krishi Rakshak</span>
        </a>

        <p class="auth-eyebrow"><i class="fa-solid fa-lock"></i> Secure password reset</p>
        <h1>New password</h1>
        <p class="auth-subtitle">Email पर मिले OTP को डालकर नया password सेट करें।</p>

        <% if (error) { %>
            <div class="auth-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <form method="post" action="/reset-password" class="auth-form">
            <div class="input-group-custom">
                <label for="email">Email address</label>
                <div class="input-box">
                    <i class="fa-regular fa-envelope"></i>
                    <input id="email" name="email" type="email" required value="<%= email %>">
                </div>
            </div>

            <div class="input-group-custom">
                <label for="otp">OTP</label>
                <div class="input-box">
                    <i class="fa-solid fa-key"></i>
                    <input id="otp" name="otp" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required
                           placeholder="6 digit OTP">
                </div>
            </div>

            <div class="input-group-custom">
                <label for="password">New password</label>
                <div class="input-box">
                    <i class="fa-solid fa-lock"></i>
                    <input id="password" name="password" type="password" minlength="6" required
                           autocomplete="new-password" placeholder="कम-से-कम 6 अक्षर">
                </div>
            </div>

            <div class="input-group-custom">
                <label for="confirm_password">Confirm password</label>
                <div class="input-box">
                    <i class="fa-solid fa-lock"></i>
                    <input id="confirm_password" name="confirm_password" type="password" minlength="6" required
                           autocomplete="new-password" placeholder="Password दोबारा डालें">
                </div>
            </div>

            <button class="auth-submit" type="submit">
                Password बदलें <i class="fa-solid fa-check"></i>
            </button>
        </form>
    </section>
</main>
</body>
</html>
