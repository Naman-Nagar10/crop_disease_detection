<!DOCTYPE html>
<html lang="hi">

<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/auth.css">
    <title><%= mode === 'login' ? 'Login' : 'Create account' %> · Krishi Rakshak</title>
</head>

<body class="auth-page">

    <main class="auth-wrapper">

        <section class="auth-card">

            <a class="auth-brand" href="/">
                <span class="brand-icon">
                    <i class="fa-solid fa-seedling"></i>
                </span>
                <span>Krishi Rakshak</span>
            </a>

            <p class="auth-eyebrow">
                <i class="fa-solid fa-leaf"></i>
                किसानों के लिए स्मार्ट खेती साथी
            </p>

            <h1>
                <%= mode === 'login' ? 'Welcome back!' : 'अपना किसान खाता बनाएं' %>
            </h1>

            <p class="auth-subtitle">
                <%= mode === 'login'
                    ? 'अपनी खेती की जानकारी और smart tools तक पहुँचें।'
                    : 'अपना account बनाकर Krishi Rakshak की सुविधाएँ पाएं।' %>
            </p>

            <% if (error) { %>
                <div class="auth-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <form method="post" action="/<%= mode %>" class="auth-form">

                <% if (mode === 'signup') { %>
                    <div class="input-group-custom">
                        <label for="name">पूरा नाम</label>
                        <div class="input-box">
                            <i class="fa-regular fa-user"></i>
                            <input
                                id="name"
                                name="name"
                                required
                                autocomplete="name"
                                placeholder="आपका नाम"
                            >
                        </div>
                    </div>
                <% } %>

                <div class="input-group-custom">
                    <label for="email">Email address</label>
                    <div class="input-box">
                        <i class="fa-regular fa-envelope"></i>
                        <input
                            id="email"
                            name="email"
                            type="email"
                            required
                            autocomplete="email"
                            placeholder="name@email.com"
                        >
                    </div>
                </div>

                <div class="input-group-custom">
                    <label for="password">Password</label>
                    <div class="input-box">
                        <i class="fa-solid fa-lock"></i>
                        <input
                            id="password"
                            name="password"
                            type="password"
                            required
                            minlength="6"
                            autocomplete="<%= mode === 'login' ? 'current-password' : 'new-password' %>"
                            placeholder="कम-से-कम 6 अक्षर"
                        >
                    </div>
                </div>

                <button class="auth-submit" type="submit">
                    <%= mode === 'login' ? 'Login करें' : 'Account बनाएं' %>
                    <i class="fa-solid fa-arrow-right"></i>
                </button>

            </form>

            <div class="divider">
                <span></span>
                <p>या</p>
                <span></span>
            </div>

            <a class="google-btn" href="/auth/google">
                <i class="fa-brands fa-google"></i>
                <span>Continue with Google</span>
            </a>

            <p class="auth-switch">
                <%= mode === 'login' ? 'नया account चाहिए?' : 'पहले से account है?' %>
                <a href="/<%= mode === 'login' ? 'signup' : 'login' %>">
                    <%= mode === 'login' ? 'Signup करें' : 'Login करें' %>
                </a>
            </p>

            <p class="auth-footer">
                <i class="fa-solid fa-shield-halved"></i>
                Secure &amp; farmer-friendly platform
            </p>

        </section>

    </main>

</body>
</html>
