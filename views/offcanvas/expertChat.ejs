<div
    class="offcanvas offcanvas-end"
    tabindex="-1"
    id="expertOffcanvas"
    aria-labelledby="expertOffcanvasLabel" 
    style="width: 500px; ">

    <div class="offcanvas-header">
        <div>
            <h2
                class="offcanvas-title"
                id="expertOffcanvasLabel">
                सही सलाह, सही समय पर
            </h2>

            <p>अपने सवाल के साथ फसल और जिले की जानकारी दें।</p>
        </div>
    
        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close">
        </button>
    </div>
    <hr>

    <div class="offcanvas-body">

        <h4>Ask an Expert</h4>

        <textarea
            class="form-control"
            rows="5"
            placeholder="अपना सवाल यहाँ लिखें...">
        </textarea>

        <button class="btn btn-success mt-3">
            Ask Question
        </button>

    </div>
</div>