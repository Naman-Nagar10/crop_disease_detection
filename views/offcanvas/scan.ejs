<div
    class="offcanvas offcanvas-end"
    tabindex="-1"
    id="scanOffcanvas"
    aria-labelledby="scanOffcanvasLabel"
    style="width: 500px;">

    <div class="offcanvas-header">
        <!-- <div>
            <h2 class="offcanvas-title" id="scanOffcanvasLabel">
                फसल की फोटो से जाँच करें
            </h2>

            <p>अच्छी रोशनी में पत्ते साफ़ फोटो लें।।</p>
        </div> -->

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close">
        </button>
    </div>
    <hr>


    <div class="offcanvas-body">

        <div class="title-container">
            <div class="title">
                <i class="fa-solid fa-upload"></i>
                <h3>फसल की<span> PHOTO भेजें</span></h3>
            </div>
            <p>अच्छी रोशनी में पत्ते की साफ़ फोटो लें।</p>
        </div>

        <hr>

       

        <div class="scn-body">

            <div class="camera-box" id="camera-box">
                <video id="video" autoplay playsinline></video>
                <img id="captured-image" class="captured-image" alt="Captured"/>
                <div class="camera-placeholder" id="camera-placeholder">
                    <i class="fa-solid fa-camera"></i>
                    Open Camera
                </div>
            </div>


            <div class="action-row">
                
                <button id="start-camera-btn" class="btn btn-success">Start Camera</button>
                <button id="click-btn" class="btn btn-success">Click</button>
                <button id="upload-btn" class="btn btn-success">Upload</button>
            </div>

            <input type="file" class="file-input" id="file-input" accept="image/*"/>

            <div class="second-link" id="second-link">Select another image</div>


        </div>

        <div id="scan-result" class="scan-result d-none">
            <h5>Disease Detected</h5>

            <p>
                Disease:
                <strong id="disease-name"></strong>
            </p>

            <p>
                Confidence:
                <strong id="confidence"></strong>%
            </p>

            <button id="details-btn" class="btn btn-success">
                View Details
            </button>
        </div>
        
    </div>
</div>