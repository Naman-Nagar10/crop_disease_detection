<div
    class="offcanvas offcanvas-end"
    tabindex="-1"
    id="mandiOffcanvas"
    aria-labelledby="mandiOffcanvasLabel"
    style="width: 500px;">

    <div class="offcanvas-header">
        <div>
            <h2 class="offcanvas-title" id="mandiOffcanvasLabel">
                Mandi Prices
            </h2>

            <p>नज़दीकी मंडियों के भाव देखकर सही समय पर सही फैसला लें।</p>
        </div>

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close">
        </button>
    </div>
    <hr>

    <div class="offcanvas-body">

        <h4>Check Mandi Price</h4>

        <label>State</label>
        <select class="form-select mb-3">
            <option>Select State</option>
            <option>Uttar Pradesh</option>
            <option>Punjab</option>
            <option>Haryana</option>
        </select>

        <label>District</label>
        <select class="form-select mb-3">
            <option>Select District</option>
        </select>

        <label>Crop</label>
        <select class="form-select mb-3">
            <option>Select Crop</option>
            <option>Wheat</option>
            <option>Rice</option>
            <option>Sugarcane</option>
        </select>

        <button class="btn btn-success w-100">
            Get Mandi Price
        </button>

    </div>
</div>