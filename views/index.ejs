<!DOCTYPE html>
<html lang="en">
<head>
    <%- include('partials/head') %>
    <title>Krishak - Home</title>
</head>
<body>
    <header>
        <%- include('partials/navbar') %>
    </header>

    <!-- ----LAYOUT---- -->

    <div class="layout">
         <!-- this is SIDEBAR -->
        <%- include('partials/sidebar') %>      

        <!-- MAIN CONTENT -->
        <!--ye main content ka page hai  -->
        <main class="main-content">  
            
            <!-- DASHBOARD  -->
            <div class="dashboard">                  
                <h1>Namaskar <span>किसान भाइयों!</span></h1>
                <p>अपने खेत की सेहत पर नज़र रखें, सही सलाह पाएं और बेहतर फैसला लें।</p>

                <!-- THIS IS HERO POSTER -->
                <section id="hero-poster">
                    <div>
                        <h1>हर दाना है अनमोल, <br><span> हर किसान है अपना</span></h1>
                        <p>स्मार्ट टेक्नोलॉजी से अब हर किसान होगा सशक्त,<br> 
                            हर खेत होगा हरा-भरा — क्योंकि <br>
                            किसान की मुस्कान ही है<br>
                            भारत की पहचान!
                        </p>
                    </div>
                </section>
                <hr>


                <!-- THIS IS TOOL SECTION -->
                <div class="tool">
                    <p>YOUR DAILY TOOLS</p>
                    <h2>जहाँ से खेती आगे बढ़े </h2>
                </div>

                <section class="tool-container">
                    <div class="card" id="scan-card">
                        <h3>फसल की Photo से <br><span>बीमारी पहचानें</span></h3>
                        <p>फसल की फोटो अपलोड करें।<br> AI तुरंत बीमारी पहचानेगा और<br> सटीक इलाज सुझाएगा।"</p>

                        <button
                            class="btn btn-success"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#scanOffcanvas"
                            aria-controls="scanOffcanvas">
                            Scan करें <i class="fa-solid fa-paper-plane"></i>
                        </button>
                        
                    </div>

                    <div class="card same-size" id="chat-card">
                        <h3>Chat with AI</h3>
                        <p>आप फसलों, कीटों (pests) या मौसम से जुड़ा कोई भी सवाल पूछ सकते हैं!</p>
                        
                        <button
                            class="btn btn-success"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#chatOffcanvas"
                            aria-controls="chatOffcanvas">
                            Chat करें  <i class="fa-solid fa-paper-plane"></i>
                        </button>
                    </div>

                    <div class="card same-size" id="scheme-card">
                        <h3>Government <br> Schemes</h3>
                        <p>View all government schemes according to your state</p>
                        <a href="/schemes" class="btn">Upload photo</a>
                    </div>
                    
                </section>

                <!-- Scan Offcanvas -->
                <%- include('offcanvas/scan') %>
                <%- include('offcanvas/aiChat') %>
                <hr>


                <!-- THIS IS ANOTHER TOOLS SECTION -->
                <div class="tool another-toll">
                    <p>ANOTHER HELPFUL TOOLS</p>
                </div>

                <section class="tool-container another-tool">

                    <!-- Mandi Price Card -->
                    <div class="card" id="mandi">
                        <div class="mandi-img">
                        </div>
                        <div class="mandi-nav">
                            <h3>Today's <span>मंडी भाव</span></h3>
                            <p>हर फसल का सही दाम, अब हर पल</p>

                            <button
                                class="btn btn-success"
                                type="button"
                                data-bs-toggle="offcanvas"
                                data-bs-target="#mandiOffcanvas"
                                aria-controls="mandiOffcanvas">
                                भाव देखें <i class="fa-solid fa-paper-plane"></i>
                            </button>
                        </div>
                    </div>


                    <!-- Expert Suggestion Card -->
                    <div class="card same-size" id="Expert">
                        <h3>Expert Suggestion</h3>
                        <p>Take expert advice</p>
                        <button
                            class="btn btn-success"
                            type="button"
                            data-bs-toggle="offcanvas"
                            data-bs-target="#expertOffcanvas"
                            aria-controls="expertSOffcanvas">
                            Ask question
                        </button>
                    </div>

                </section>


                <!-- Mandi/expert Offcanvas -->
                <%- include('offcanvas/mandiprice') %>
                <%- include('offcanvas/expertChat') %>
 
            </div>
        </main>
        <%- include('partials/footer') %>
    </div>

    
    
    <%- include('partials/script') %>
</body>
</html>