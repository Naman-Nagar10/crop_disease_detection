<div
    class="offcanvas offcanvas-end"
    tabindex="-1"
    id="scanOffcanvas"
    aria-labelledby="scanOffcanvasLabel"
    style="width: 500px;">

    <div class="offcanvas-header">

        <button
            type="button"
            class="btn-close"
            data-bs-dismiss="offcanvas"
            aria-label="Close">
        </button>

    </div>

    <hr>

    <div class="offcanvas-body">

        <div class="title-container">

            <div class="title">

                <i class="fa-solid fa-leaf"></i>

                <h3>
                    फसल की <span>PHOTO भेजें</span>
                </h3>

            </div>

            <p>
                पहले फसल चुनें और फिर पत्ते की साफ़ फोटो लें।
            </p>

        </div>

        <hr>


        <!-- ================= CROP SELECT ================= -->

        <div class="crop-selection">

            <label for="crop-select">
                <strong>फसल चुनें</strong>
            </label>

            <select
                id="crop-select"
                class="form-select">

                <option value="">
                    -- फसल चुनें --
                </option>

                <option value="Sugarcane">
                    गन्ना (Sugarcane)
                </option>

                <option value="Rice">
                    धान (Rice)
                </option>

                <option value="Wheat">
                    गेहूं (Wheat)
                </option>

            </select>

        </div>


        <!-- ================= CAMERA ================= -->

        <div class="scn-body">

            <div
                class="camera-box"
                id="camera-box">

                <video
                    id="video"
                    autoplay
                    playsinline>
                </video>

                <img
                    id="captured-image"
                    class="captured-image"
                    alt="Captured image">

                <div
                    class="camera-placeholder"
                    id="camera-placeholder">

                    <i class="fa-solid fa-camera"></i>

                    <span>
                        Camera / Image
                    </span>

                </div>

            </div>


            <!-- ================= ACTION BUTTONS ================= -->

            <div class="action-row">

                <button
                    id="start-camera-btn"
                    class="btn btn-success">

                    <i class="fa-solid fa-camera"></i>
                    Camera

                </button>


                <button
                    id="click-btn"
                    class="btn btn-success">

                    <i class="fa-solid fa-camera-retro"></i>
                    Click

                </button>


                <button
                    id="upload-btn"
                    class="btn btn-success">

                    <span
                        id="upload-spinner"
                        class="spinner-border spinner-border-sm d-none">
                    </span>

                    <i
                        id="upload-icon"
                        class="fa-solid fa-upload">
                    </i>

                    <span id="upload-text">
                        Detect
                    </span>

                </button>

            </div>


            <!-- Hidden file input -->

            <input
                type="file"
                id="file-input"
                class="file-input"
                accept="image/*"
                capture="environment">


            <div
                class="second-link"
                id="second-link">

                Select another image

            </div>

        </div>


        <!-- ================= RESULT ================= -->

        <div
            id="scan-result"
            class="scan-result d-none">

            <h5 id="result-heading">
                Disease Detected
            </h5>


            <p>
                Crop:
                <strong id="crop-name"></strong>
            </p>


            <p id="disease-row">

                Disease:
                <strong id="disease-name"></strong>

            </p>


            <p>
                Confidence:
                <strong id="confidence"></strong>%

            </p>


            <!-- Healthy message -->

            <div
                id="healthy-message"
                class="healthy-message d-none">

                <i class="fa-solid fa-circle-check"></i>

                <span>
                    आपकी फसल स्वस्थ दिखाई दे रही है।
                    नियमित रूप से फसल की निगरानी और उचित देखभाल जारी रखें।
                </span>

            </div>


            <!-- Disease details -->

            <button
                id="details-btn"
                class="btn btn-success d-none">

                <i class="fa-solid fa-stethoscope"></i>

                View Details

            </button>

        </div>

    </div>

</div>