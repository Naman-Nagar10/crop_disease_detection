<!DOCTYPE html>
<html lang="hi"><head><%- include('partials/head') %><title>Government Schemes · Krishi Rakshak</title></head>
<body><header><%- include('partials/navbar') %></header><div class="layout"><%- include('partials/sidebar') %><main class="main-content page-content"><a class="back-link" href="/"><i class="fa-solid fa-arrow-left"></i> Dashboard</a><div class="page-heading"><p class="eyebrow">सरकारी सहायता</p><h1>आपके लिए <span>Government Schemes</span></h1><p>खेती के लिए उपयोगी योजनाएं—eligibility और आवेदन की जानकारी के साथ।</p></div><div class="scheme-grid"><% schemes.forEach(scheme => { %><article class="scheme-card"><div class="scheme-icon"><i class="fa-solid fa-landmark"></i></div><span class="scheme-state"><i class="fa-solid fa-location-dot"></i> <%= scheme.state %></span><h3><%= scheme.title %></h3><p><%= scheme.description %></p><div class="benefit"><small>मुख्य लाभ</small><strong><%= scheme.benefit %></strong></div><a href="<%= scheme.link %>" target="_blank" rel="noopener" class="btn btn-success">Details देखें <i class="fa-solid fa-arrow-up-right-from-square"></i></a></article><% }) %></div></main></div></body></html>
