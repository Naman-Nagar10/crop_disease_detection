<!DOCTYPE html>
<html lang="hi">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/profile.css">
    <title>My Profile · Krishi Rakshak</title>
</head>
<body class="profile-page">
<header>
    <%- include('partials/navbar') %>
</header>

<div class="layout">
    <%- include('partials/sidebar') %>

    <main class="main-content">
        <section class="profile-card">
            <div class="profile-heading">
                <div>
                    <p class="profile-eyebrow">ACCOUNT</p>
                    <h1>My Profile</h1>
                    <p>अपनी profile details और profile picture manage करें।</p>
                </div>
            </div>

            <% if (error) { %>
                <div class="profile-alert error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span><%= error %></span>
                </div>
            <% } %>

            <% if (success) { %>
                <div class="profile-alert success">
                    <i class="fa-solid fa-circle-check"></i>
                    <span><%= success %></span>
                </div>
            <% } %>

            <form method="post" action="/profile" enctype="multipart/form-data" class="profile-form">
                <div class="profile-photo-section">
                    <div class="profile-avatar">
                        <% if (user.profile_picture) { %>
                            <img src="<%= user.profile_picture %>" alt="Profile picture">
                        <% } else { %>
                            <i class="fa-solid fa-user"></i>
                        <% } %>
                    </div>

                    <div>
                        <h3>Profile picture</h3>
                        <p>JPG, PNG, WEBP या GIF · अधिकतम 2 MB</p>
                        <label class="profile-upload-btn" for="profile_picture">
                            <i class="fa-solid fa-camera"></i> Photo बदलें
                        </label>
                        <input id="profile_picture" name="profile_picture" type="file"
                               accept="image/jpeg,image/png,image/webp,image/gif" hidden>
                    </div>
                </div>

                <div class="profile-fields">
                    <div class="input-group-custom">
                        <label for="name">पूरा नाम</label>
                        <div class="input-box">
                            <i class="fa-regular fa-user"></i>
                            <input id="name" name="name" required maxlength="100" value="<%= user.name %>">
                        </div>
                    </div>

                    <div class="input-group-custom">
                        <label for="email">Email address</label>
                        <div class="input-box disabled-input">
                            <i class="fa-regular fa-envelope"></i>
                            <input id="email" type="email" value="<%= user.email %>" disabled>
                        </div>
                        <small>Email account login के लिए linked है, इसलिए यहाँ change नहीं किया गया है।</small>
                    </div>
                </div>

                <button class="profile-save-btn" type="submit">
                    <i class="fa-solid fa-floppy-disk"></i> Save profile
                </button>
            </form>
        </section>
    </main>

    <%- include('partials/footer') %>
</div>

<%- include('partials/script') %>
<script>
    const profileInput = document.getElementById("profile_picture");
    const profilePreview = document.querySelector(".profile-avatar");

    profileInput?.addEventListener("change", function () {
        const file = this.files?.[0];

        if (!file) return;

        if (file.size > 2 * 1024 * 1024) {
            alert("Profile picture अधिकतम 2 MB की होनी चाहिए।");
            this.value = "";
            return;
        }

        if (profilePreview && file.type.startsWith("image/")) {
            const reader = new FileReader();
            reader.onload = (event) => {
                profilePreview.innerHTML = `<img src="${event.target.result}" alt="Profile picture preview">`;
            };
            reader.readAsDataURL(file);
        }
    });
</script>
</body>
</html>
