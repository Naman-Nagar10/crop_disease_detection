<!DOCTYPE html>
<html lang="hi">
<head>
    <%- include('partials/head') %>
    <link rel="stylesheet" href="/css/auth.css">
    <title>Forgot Password · Krishi Rakshak</title>
</head>
<body class="auth-page">
<main class="auth-wrapper">
    <section class="auth-card">
        <a class="auth-brand" href="/">
            <span class="brand-icon"><i class="fa-solid fa-seedling"></i></span>
            <span>Krishi Rakshak</span>
        </a>

        <p class="auth-eyebrow"><i class="fa-solid fa-key"></i> Password recovery</p>
        <h1>Forgot password?</h1>
        <p class="auth-subtitle">अपने registered email पर OTP मंगाकर password reset करें।</p>

        <% if (error) { %>
            <div class="auth-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span><%= error %></span>
            </div>
        <% } %>

        <% if (success) { %>
            <div class="auth-success">
                <i class="fa-solid fa-circle-check"></i>
                <span><%= success %></span>
            </div>
            <a class="auth-submit" style="text-decoration:none;" href="/reset-password?email=<%= encodeURIComponent(email) %>">
                OTP डालकर password reset करें
                <i class="fa-solid fa-arrow-right"></i>
            </a>
        <% } else { %>
            <form method="post" action="/forgot-password" class="auth-form">
                <div class="input-group-custom">
                    <label for="email">Email address</label>
                    <div class="input-box">
                        <i class="fa-regular fa-envelope"></i>
                        <input id="email" name="email" type="email" required autocomplete="email"
                               value="<%= email %>" placeholder="name@email.com">
                    </div>
                </div>
                <button class="auth-submit" type="submit">
                    OTP भेजें <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
        <% } %>

        <p class="auth-switch">
            Password याद आ गया?
            <a href="/login">Login करें</a>
        </p>
    </section>
</main>
</body>
</html>
